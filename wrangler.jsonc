{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cga-ghl-browser",
  "main": "src/index.js",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],

  "browser": {
    "binding": "BROWSER"
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "BROWSER_MANAGER",
        "class_name": "BrowserManager"
      }
    ]
  },

  "exports": {
    "BrowserManager": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
